# Copy this file to .env before running Streamlit.
# All secrets are loaded from .env. Do not paste API keys into Streamlit UI.

RESPONSE_MODEL=mistral:latest
GUARD_MODEL=llama3:latest
EMBEDDINGS_MODEL=nomic-embed-text:latest
MEMORY_EMBEDDINGS_MODEL=paraphrase-multilingual-MiniLM-L12-v2
DATA_FOLDER=./owasp_rag_data
QDRANT_PATH=./qdrant_local
QDRANT_COLLECTION=security_assistant
MASVS_FILE=./masvs.json
MEMORY_INDEX_PATH=./faiss_memory_enhanced
CHUNK_SIZE=900
CHUNK_OVERLAP=120
CACHE_TTL_MINUTES=60
CACHE_MAX_SIZE=100
MEMORY_COMPRESSION_THRESHOLD=30
ENABLE_CACHE=true

# Web search
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=

# LangSmith Observability
ENABLE_LANGSMITH=false
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mobile-security-assistant

# Legacy LangChain tracing aliases kept for compatibility with older packages.
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=mobile-security-assistant
